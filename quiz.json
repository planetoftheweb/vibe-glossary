    { "id": "llm",             "term": "LLM",                "definition": "A neural network that predicts the next word, over and over.",                        "category": "AI Literacy",   "difficulty": 1, "distractors": ["RAG", "Fine-tuning", "MoE", "AI Agent"] },
    { "id": "context-window",  "term": "Context Window",     "definition": "The maximum tokens (input + output) a model can hold at once.",                      "category": "AI Literacy",   "difficulty": 2, "distractors": ["Temperature", "RAG", "System Prompt", "Tokens"] },
    { "id": "tokens",          "term": "Tokens",             "definition": "The units an LLM thinks in — roughly 3-4 characters of English each.",               "category": "AI Literacy",   "difficulty": 2, "distractors": ["Context Window", "Parameters", "Embeddings", "Weights"] },
    { "id": "system-prompt",   "term": "System Prompt",      "definition": "Instructions you give the AI before the user says anything, setting the rules.",      "category": "AI Literacy",   "difficulty": 1, "distractors": ["User Story", "Few-shot", "Temperature", "RAG"] },
    { "id": "temperature",     "term": "Temperature",        "definition": "A dial that controls how random or repetitive the AI's output is.",                   "category": "AI Literacy",   "difficulty": 1, "distractors": ["Context Window", "Top-p", "Tokens", "System Prompt"] },
    { "id": "multimodal",      "term": "Multimodal",         "definition": "A model that handles text and images (and sometimes audio) in the same call.",        "category": "AI Literacy",   "difficulty": 2, "distractors": ["MoE", "RAG", "Fine-tuning", "Tool Calling"] },
    { "id": "moe",             "term": "MoE",                "definition": "An architecture that routes each token to 1-2 expert sub-networks to stay fast.",     "category": "AI Literacy",   "difficulty": 3, "distractors": ["RAG", "Fine-tuning", "Tool Calling", "LLM"] },
    { "id": "ai-agent",        "term": "AI Agent",           "definition": "An LLM in a loop that takes actions, reads the results, and decides the next step.",  "category": "AI Literacy",   "difficulty": 1, "distractors": ["Tool Calling", "RAG", "MCP", "Fine-tuning"] },
    { "id": "tool-calling",    "term": "Tool Calling",       "definition": "The model picks a function and writes its arguments as JSON; your code runs it.",     "category": "AI Literacy",   "difficulty": 2, "distractors": ["AI Agent", "MCP", "RAG", "System Prompt"] },
    { "id": "mcp",             "term": "MCP",                "definition": "An open protocol so any AI client can connect to any tool server — like USB-C.",      "category": "AI Literacy",   "difficulty": 2, "distractors": ["Tool Calling", "RAG", "AI Agent", "API"] },
    { "id": "rag",             "term": "RAG",                "definition": "Search your docs first, paste the relevant chunks in the prompt, then answer.",        "category": "AI Literacy",   "difficulty": 2, "distractors": ["Fine-tuning", "Tool Calling", "System Prompt", "LLM"] },
    { "id": "fine-tuning",     "term": "Fine-tuning",        "definition": "Training a model on your own examples to change how it consistently behaves.",         "category": "AI Literacy",   "difficulty": 2, "distractors": ["RAG", "Prompting", "Tool Calling", "MoE"] },
    { "id": "hallucination",   "term": "Hallucination",      "definition": "When an AI confidently generates something that sounds right but is wrong.",           "category": "AI Literacy",   "difficulty": 1, "distractors": ["Eval", "RAG", "Temperature", "Fine-tuning"] },
    { "id": "eval",            "term": "Eval",               "definition": "A fixed set of AI inputs and graded outputs you re-run to catch regressions.",         "category": "AI Literacy",   "difficulty": 2, "distractors": ["Hallucination", "CI", "Unit Test", "RAG"] },
    { "id": "few-shot",        "term": "Few-shot Prompting",  "definition": "Putting example input/output pairs in the prompt so the model copies the pattern.",   "category": "AI Literacy",   "difficulty": 2, "distractors": ["Fine-tuning", "System Prompt", "RAG", "Temperature"] },
    { "id": "embeddings",      "term": "Embeddings",         "definition": "Numbers that capture the meaning of text so similar ideas are close in vector space.",  "category": "AI Literacy",   "difficulty": 3, "distractors": ["Tokens", "RAG", "Fine-tuning", "Context Window"] },

    { "id": "design-system",   "term": "Design System",      "definition": "The complete rulebook: tokens, components, principles, and documentation.",           "category": "Design",        "difficulty": 1, "distractors": ["Component Library", "UI Kit", "Style Guide", "Design Tokens"] },
    { "id": "design-tokens",   "term": "Design Tokens",      "definition": "Named values for color, spacing, and type so one edit updates the whole product.",    "category": "Design",        "difficulty": 1, "distractors": ["Design System", "CSS Variables", "Typography Scale", "Color Palette"] },
    { "id": "type-scale",      "term": "Typography Scale",   "definition": "A fixed set of font sizes used everywhere instead of ad-hoc values.",                  "category": "Design",        "difficulty": 2, "distractors": ["Spacing Scale", "Design Tokens", "Color Palette", "Density"] },
    { "id": "spacing-scale",   "term": "Spacing Scale",      "definition": "Multiples of 4 or 8px for every gap and padding — no odd numbers allowed.",           "category": "Design",        "difficulty": 2, "distractors": ["Typography Scale", "Box Model", "Design Tokens", "Density"] },
    { "id": "color-palette",   "term": "Color Palette",      "definition": "Three layers: brand colors, neutral grays, and semantic (success, warning, danger).",  "category": "Design",        "difficulty": 1, "distractors": ["Design Tokens", "Color Picker", "Typography Scale", "Elevation"] },
    { "id": "comp-states",     "term": "Component States",   "definition": "Default, hover, focus, active, disabled, and loading — every control needs all six.",  "category": "Design",        "difficulty": 2, "distractors": ["Variants", "Density", "Design Tokens", "Toggle Button"] },
    { "id": "variants",        "term": "Variants",           "definition": "Flavors of the same component: primary, secondary, ghost, outline, destructive.",      "category": "Design",        "difficulty": 1, "distractors": ["Component States", "Sizes", "Design Tokens", "Density"] },
    { "id": "density",         "term": "Density",            "definition": "How much padding a component has: compact, default, or comfortable.",                  "category": "Design",        "difficulty": 2, "distractors": ["Variants", "Spacing Scale", "Box Model", "Component States"] },
    { "id": "elevation",       "term": "Elevation",          "definition": "Shadows that communicate how high above the page an element appears to float.",        "category": "Design",        "difficulty": 2, "distractors": ["Position Absolute", "Z-index", "Box Model", "Density"] },

    { "id": "box-model",       "term": "Box Model",          "definition": "Content, padding, border, margin — the four nested layers of every element.",          "category": "Web",           "difficulty": 1, "distractors": ["Flexbox", "CSS Grid", "Margin vs Padding", "Display"] },
    { "id": "flexbox",         "term": "Flexbox",            "definition": "A one-directional layout: a row or column with gap and alignment controls.",           "category": "Web",           "difficulty": 1, "distractors": ["CSS Grid", "Box Model", "Display", "Position Absolute"] },
    { "id": "css-grid",        "term": "CSS Grid",           "definition": "A two-directional layout that controls rows and columns at the same time.",            "category": "Web",           "difficulty": 1, "distractors": ["Flexbox", "Box Model", "Masonry", "Sticky Header"] },
    { "id": "semantic-html",   "term": "Semantic HTML",      "definition": "Using tags that say what content IS, like button, nav, article, and main.",           "category": "Web",           "difficulty": 1, "distractors": ["ARIA", "DOM", "Accessibility Tree", "Box Model"] },
    { "id": "dom",             "term": "DOM",                "definition": "The live tree the browser builds from your HTML that JavaScript walks and modifies.",   "category": "Web",           "difficulty": 1, "distractors": ["Accessibility Tree", "Semantic HTML", "ARIA", "CSS Grid"] },
    { "id": "aria",            "term": "ARIA",               "definition": "Attributes like aria-label and aria-expanded that fill gaps semantic HTML cannot.",    "category": "Web",           "difficulty": 2, "distractors": ["Semantic HTML", "DOM", "Focus Ring", "Accessibility Tree"] },
    { "id": "a11y-tree",       "term": "Accessibility Tree", "definition": "A parallel tree of roles and names that screen readers use instead of the DOM.",       "category": "Web",           "difficulty": 3, "distractors": ["DOM", "ARIA", "Semantic HTML", "Focus Ring"] },
    { "id": "focus-ring",      "term": "Focus Ring",         "definition": "The visible outline that shows keyboard users which element is currently active.",      "category": "Web",           "difficulty": 1, "distractors": ["ARIA", "Touch Target", "Accessibility Tree", "Tooltip"] },
    { "id": "color-contrast",  "term": "Color Contrast",     "definition": "Text needs at least 4.5:1 contrast against its background for WCAG AA.",              "category": "Web",           "difficulty": 2, "distractors": ["Color Palette", "Focus Ring", "Elevation", "Accessibility"] },
    { "id": "touch-target",    "term": "Touch Target",       "definition": "Anything tappable on mobile should be at least 44 by 44 pixels.",                     "category": "Web",           "difficulty": 2, "distractors": ["Focus Ring", "Color Contrast", "Keyboard Nav", "ARIA"] },
    { "id": "specificity",     "term": "CSS Specificity",    "definition": "When two rules target the same element, the more specific selector wins.",             "category": "Web",           "difficulty": 2, "distractors": ["CSS Cascade", "CSS Grid", "Box Model", "ARIA"] },
    { "id": "margin-padding",  "term": "Margin vs Padding",  "definition": "Padding is inside the border. Margin pushes neighbors away outside the border.",       "category": "Web",           "difficulty": 1, "distractors": ["Box Model", "Flexbox", "CSS Grid", "Spacing Scale"] },
    { "id": "position-abs",    "term": "Position Absolute",  "definition": "Pulled out of flow and anchored to the nearest parent that has position set.",         "category": "Web",           "difficulty": 2, "distractors": ["Position Fixed", "Flexbox", "Z-index", "Elevation"] },
    { "id": "position-sticky", "term": "Position Sticky",    "definition": "Behaves like normal flow until you scroll past it, then pins to the viewport edge.",   "category": "Web",           "difficulty": 2, "distractors": ["Position Fixed", "Position Absolute", "Sticky Header", "Flexbox"] },
    { "id": "css-rem",         "term": "rem",                "definition": "A CSS unit that scales with the user's root font size — great for accessibility.",     "category": "Web",           "difficulty": 2, "distractors": ["em", "px", "vh", "Spacing Scale"] },
    { "id": "keyboard-nav",    "term": "Keyboard Navigation", "definition": "Tab between widgets, arrow keys within a widget, Escape to close, Enter to activate.", "category": "Web",           "difficulty": 2, "distractors": ["Focus Ring", "ARIA", "Touch Target", "Accessibility Tree"] },
    { "id": "block-inline",    "term": "Block vs Inline",    "definition": "Block elements take the full row. Inline elements share the row with neighbors.",      "category": "Web",           "difficulty": 1, "distractors": ["Flexbox", "CSS Grid", "Display", "Box Model"] },

    { "id": "mvp",             "term": "MVP",                "definition": "The smallest version of an idea you can test with real users to validate it.",         "category": "Product",       "difficulty": 1, "distractors": ["PRD", "Sprint", "OKRs", "User Story"] },
    { "id": "prd",             "term": "PRD",                "definition": "A short doc describing what to build, who it's for, and what done looks like.",         "category": "Product",       "difficulty": 2, "distractors": ["User Story", "OKRs", "Acceptance Criteria", "Roadmap"] },
    { "id": "user-story",      "term": "User Story",         "definition": "'As a ___, I want ___, so that ___.' Keeps features tied to real user needs.",         "category": "Product",       "difficulty": 1, "distractors": ["Acceptance Criteria", "PRD", "JTBD", "OKRs"] },
    { "id": "acceptance",      "term": "Acceptance Criteria", "definition": "A checklist of observable behaviors that prove a feature is done.",                   "category": "Product",       "difficulty": 2, "distractors": ["User Story", "Unit Test", "PRD", "OKRs"] },
    { "id": "north-star",      "term": "North-star Metric",  "definition": "The one number the whole team aligns on — if it goes up, the product is winning.",     "category": "Product",       "difficulty": 2, "distractors": ["OKRs", "KPI", "Eval", "Sprint"] },
    { "id": "okrs",            "term": "OKRs",               "definition": "One inspiring Objective plus 2-4 numeric Key Results for a quarter.",                  "category": "Product",       "difficulty": 2, "distractors": ["North-star Metric", "PRD", "Sprint", "Roadmap"] },
    { "id": "jtbd",            "term": "JTBD",               "definition": "'When X, I want Y so I can Z.' Features framed by situation, not by persona.",         "category": "Product",       "difficulty": 3, "distractors": ["User Story", "Personas", "PRD", "OKRs"] },
    { "id": "roadmap",         "term": "Roadmap",            "definition": "A promise about direction (Now / Next / Later), not a calendar of hard dates.",        "category": "Product",       "difficulty": 1, "distractors": ["Sprint", "OKRs", "PRD", "Backlog"] },
    { "id": "sprint",          "term": "Sprint",             "definition": "A fixed 1-2 week window where the team commits to and ships a small batch of work.",    "category": "Product",       "difficulty": 1, "distractors": ["Roadmap", "MVP", "OKRs", "CI"] },
    { "id": "personas",        "term": "User Personas",      "definition": "A fictional but research-grounded profile of a representative user with goals and pain.", "category": "Product",       "difficulty": 1, "distractors": ["User Story", "JTBD", "PRD", "Acceptance Criteria"] },

    { "id": "tdd",             "term": "TDD",                "definition": "Write a failing test first, then the minimum code to make it pass, then clean up.",    "category": "Engineering",   "difficulty": 2, "distractors": ["CI", "Unit Test", "Code Review", "Feature Flag"] },
    { "id": "unit-test",       "term": "Unit Test",          "definition": "Tests one small piece in isolation with all dependencies mocked.",                     "category": "Engineering",   "difficulty": 1, "distractors": ["Integration Test", "TDD", "CI", "Eval"] },
    { "id": "integration-test","term": "Integration Test",   "definition": "Tests several pieces talking to each other with real dependencies.",                   "category": "Engineering",   "difficulty": 2, "distractors": ["Unit Test", "TDD", "CI", "Eval"] },
    { "id": "ci",              "term": "CI",                 "definition": "A robot that runs your tests on every push so broken code never silently lands.",       "category": "Engineering",   "difficulty": 1, "distractors": ["Feature Flag", "Staging", "TDD", "Code Review"] },
    { "id": "feature-flag",    "term": "Feature Flag",       "definition": "A switch that turns a feature on or off without shipping new code.",                   "category": "Engineering",   "difficulty": 1, "distractors": ["CI", "Staging", "SemVer", "A/B Test"] },
    { "id": "semver",          "term": "SemVer",             "definition": "MAJOR.MINOR.PATCH: breaking, additive, and bug-fix releases labeled clearly.",         "category": "Engineering",   "difficulty": 2, "distractors": ["CI", "Feature Flag", "Staging", "Roadmap"] },
    { "id": "staging",         "term": "Staging",            "definition": "A copy of production you can break safely before real users see the change.",           "category": "Engineering",   "difficulty": 1, "distractors": ["CI", "Feature Flag", "Code Review", "TDD"] },
    { "id": "code-review",     "term": "Code Review",        "definition": "A teammate reads your change before it merges, checking understanding and safety.",     "category": "Engineering",   "difficulty": 1, "distractors": ["CI", "TDD", "Eval", "Acceptance Criteria"] },
    { "id": "refactoring",     "term": "Refactoring",        "definition": "Improving the structure of code without changing what it does.",                       "category": "Engineering",   "difficulty": 1, "distractors": ["TDD", "Code Review", "Feature Flag", "CI"] },
    { "id": "tech-debt",       "term": "Tech Debt",          "definition": "Work you deferred to ship faster that will cost you later if not paid down.",          "category": "Engineering",   "difficulty": 1, "distractors": ["Refactoring", "Feature Flag", "SemVer", "Staging"] },

    { "id": "git-commit",      "term": "Commit",             "definition": "A saved snapshot of your changes with a message describing what and why.",              "category": "Git",           "difficulty": 1, "distractors": ["Branch", "Pull Request", "Merge", "Rebase"] },
    { "id": "git-branch",      "term": "Branch",             "definition": "A separate line of development so you can work without touching the main codebase.",   "category": "Git",           "difficulty": 1, "distractors": ["Commit", "Pull Request", "Fork", "Merge"] },
    { "id": "git-pr",          "term": "Pull Request",       "definition": "A proposal to merge your branch into main, with a diff, description, and review.",     "category": "Git",           "difficulty": 1, "distractors": ["Commit", "Branch", "Merge", "Fork"] },
    { "id": "git-merge",       "term": "Merge",              "definition": "Combines changes from one branch into another, keeping the full history.",              "category": "Git",           "difficulty": 1, "distractors": ["Rebase", "Commit", "Pull Request", "Fork"] },
    { "id": "git-rebase",      "term": "Rebase",             "definition": "Replays your commits on top of another branch for a clean, linear history.",           "category": "Git",           "difficulty": 2, "distractors": ["Merge", "Cherry-pick", "Commit", "Branch"] },
    { "id": "git-stash",       "term": "Git Stash",          "definition": "Temporarily saves uncommitted changes so you can switch context and come back.",        "category": "Git",           "difficulty": 2, "distractors": ["Commit", "Branch", "Rebase", "Fork"] }
  ]
}
